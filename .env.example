# Postgres (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ftp

# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a Redirect URI registered in the Discord app
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Long random strings (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Shared secret the Roblox game sends as "Authorization: Bearer <key>"
INGEST_API_KEY=
