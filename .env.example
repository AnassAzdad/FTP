# Postgres (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ftp

# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a Redirect URI registered in the Discord app
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Long random strings (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Shared secret the Roblox game sends as "Authorization: Bearer <key>"
INGEST_API_KEY=

# --- Discord fixtures sync (optional) ---
# Bot token from the same Discord app: Bot -> Reset Token. Needs "Message Content Intent".
DISCORD_BOT_TOKEN=
# Right-click the fixtures channel -> Copy Channel ID (Developer Mode must be on)
DISCORD_FIXTURES_CHANNEL_ID=
# Secret the scheduler sends as "Authorization: Bearer <secret>" to /api/sync/discord
CRON_SECRET=
# IANA time zone used when a fixture only gives a clock time, e.g. Europe/London
LEAGUE_TZ=Europe/London
